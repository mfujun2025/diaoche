{
  "_说明": "吊车.cn 每日文章机器人的全部配置。敏感信息一律不写在这里，用 env:xxx 引用环境变量。复制本文件为 article-bot.json 后按需修改。",

  "schedule": {
    "cron": "0 1 * * *",
    "_cron说明": "GitHub Actions 用 UTC。0 1 * * * = 北京时间 09:00。改这里的同时要改 .github/workflows/daily-article.yml 里的 cron（两者需一致）",
    "timezone": "Asia/Shanghai",
    "enabled": true
  },

  "article": {
    "minWords": 1000,
    "maxWords": 1500,
    "descriptionWords": [50, 80],
    "h2Range": [3, 5],
    "internalLinks": [3, 4],
    "brandSuffix": "| 吊车.cn",
    "coreWord": "吊车",
    "keywordDensity": { "min": 0.8, "max": 2.8 },
    "titleMaxChars": 30
  },

  "llm": {
    "provider": "openai-compatible",
    "baseUrlEnv": "LLM_BASE_URL",
    "baseUrlDefault": "https://api.deepseek.com/v1",
    "apiKeyEnv": "LLM_API_KEY",
    "modelEnv": "LLM_MODEL",
    "modelDefault": "deepseek-chat",
    "temperature": 0.7,
    "maxTokens": 4096,
    "timeoutMs": 180000
  },

  "publish": {
    "target": "git",
    "git": {
      "repoEnv": "GITHUB_REPOSITORY",
      "repoDefault": "mfujun2025/diaoche",
      "branchEnv": "ARTICLE_BOT_BRANCH",
      "branchDefault": "main",
      "dir": "src/articles",
      "tokenEnv": "ARTICLE_BOT_GH_TOKEN",
      "_token说明": "GitHub Actions 里可用内置的 secrets.GITHUB_TOKEN；本机跑要填自己的 PAT（repo 权限）",
      "commitMessagePrefix": "每日文章"
    },
    "http": {
      "urlEnv": "ARTICLE_API_URL",
      "urlDefault": "",
      "tokenEnv": "ARTICLE_API_TOKEN",
      "method": "POST",
      "timeoutMs": 30000
    },
    "dir": {
      "path": "out/articles"
    }
  },

  "retry": {
    "attempts": 3,
    "backoffMs": [3000, 10000, 25000]
  },

  "dedupe": {
    "maxTitleSimilarity": 0.55,
    "maxKeywordSimilarity": 0.8,
    "_说明": "相似度用 2-gram Jaccard。超过阈值视为重复主题，跳过并选下一个"
  },

  "alert": {
    "webhookEnv": "ARTICLE_BOT_WEBHOOK",
    "_webhook说明": "留空则只写日志。支持飞书机器人、企业微信机器人（群里添加机器人后拿到的 webhook 地址）",
    "onFailureOnly": true,
    "timeoutMs": 15000
  },

  "logging": {
    "dir": "logs",
    "file": "article-bot.jsonl",
    "maxEntries": 500
  },

  "bannedPhrases": [
    "综上所述",
    "总的来说",
    "在当今社会",
    "随着科技的不断发展",
    "希望本文对您有所帮助",
    "以上就是",
    "总而言之"
  ],

